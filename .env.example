# Vercel AI Gateway API key (gateway-served tiers: reasoning, vision, coding; also the
# embeddings classifier and the Jev gateway transport).
# Create one in your Vercel dashboard -> AI Gateway -> API Keys.
AI_GATEWAY_API_KEY=

# OpenRouter API key (fast tier via the legacy 'openrouter/auto' router).
# NOTE: OpenRouter's legacy Auto router is deprecated upstream (Auto Beta exists);
# this project intentionally stays on the stable legacy slug.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# TypeSafe API key — only needed for the Jev shadow classifier's DIRECT transport
# (JEV_TRANSPORT=direct, the default). Jev through the gateway uses AI_GATEWAY_API_KEY instead.
# Model is pinned in code to jev-1.13.0 (direct) / typesafe-ai/jev (gateway).
# https://typesafe.ai
# TYPESAFE_API_KEY=

# Optional: Jev transport. 'direct' = TypeSafe API + TYPESAFE_API_KEY.
# 'gateway' = Vercel AI Gateway TypeSafe route + AI_GATEWAY_API_KEY.
# JEV_TRANSPORT=gateway

# Optional: override the direct TypeSafe API base URL.
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# Optional: TIER PROFILE — which model map to use.
#   quality (default) = premium models (opus/gpt-4o/sonnet); quality-first.
#   budget            = cheap/free models hosted ON the gateway (Qwen-centric),
#                       zero local compute. Prices in code are 2026-09 snapshots — verify.
# TIER_PROFILE=budget

# Optional: force the fast-tier backend ('gateway', 'openrouter', or 'local').
# Built-in default: openrouter. The deployed Vercel project sets this to
# FAST_TIER_PROVIDER=openrouter (Production/Preview/Development).
# With TIER_PROFILE=budget, use 'gateway' so the fast tier also uses the cheap model.
# FAST_TIER_PROVIDER=openrouter

# Optional (LEGACY, opt-in only): local OpenAI-compatible server for the fast tier.
# No local server is part of the intended setup; prefer hosted providers.
# LOCAL_LLM_BASE_URL=
# LOCAL_LLM_API_KEY=
# LOCAL_LLM_MODEL=

# Optional: classifier strategy. 'auto' (default) = embeddings when AI_GATEWAY_API_KEY
# is set, else regex. 'semantic' = always embeddings. 'regex' = free/offline heuristic.
# CLASSIFIER=auto
# Optional: embedding model for the semantic classifier.
# EMBED_MODEL=openai/text-embedding-3-small

# Optional: credit-warning thresholds in USD (warnings only — never caps).
# CREDIT_WARN_THRESHOLD_USD=5
# CREDIT_CRITICAL_THRESHOLD_USD=1