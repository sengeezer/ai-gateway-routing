# Vercel AI Gateway API key (gateway-served tiers: reasoning, vision, coding).
# Create one in your Vercel dashboard -> AI Gateway -> API Keys.
AI_GATEWAY_API_KEY=

# OpenRouter API key (default 'fast' tier via openrouter/auto).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: TIER PROFILE — which model map to use.
#   quality (default) = premium models (opus/gpt-4o/sonnet); quality-first.
#   budget            = cheap/free models hosted ON the gateway (Qwen-centric),
#                       zero local compute. ~20-150x cheaper per tier. See README.
# TIER_PROFILE=budget

# Optional: force the fast-tier backend ('gateway', 'openrouter', or 'local').
# With TIER_PROFILE=budget, use 'gateway' so the fast tier also uses the cheap model.
# FAST_TIER_PROVIDER=gateway

# Optional (legacy): local OpenAI-compatible server for the fast tier (e.g. Qwen via
# llama.cpp). Only if FAST_TIER_PROVIDER=local. Prefer TIER_PROFILE=budget (hosted, no
# machine load) unless you specifically want on-device inference.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_API_KEY=local
# LOCAL_LLM_MODEL=Qwen3.6-35B-A3B

# Optional: classifier strategy. 'auto' (default) = embeddings when AI_GATEWAY_API_KEY
# is set, else regex. 'semantic' = always embeddings. 'regex' = free/offline heuristic.
# CLASSIFIER=auto
# Optional: embedding model for the semantic classifier.
# EMBED_MODEL=openai/text-embedding-3-small

# Optional: credit-warning thresholds in USD.
# CREDIT_WARN_THRESHOLD_USD=5
# CREDIT_CRITICAL_THRESHOLD_USD=1
