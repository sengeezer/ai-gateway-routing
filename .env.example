# Vercel AI Gateway API key (gateway-served tiers: reasoning, vision, coding).
# Create one in your Vercel dashboard -> AI Gateway -> API Keys.
AI_GATEWAY_API_KEY=

# OpenRouter API key (default 'fast' tier via openrouter/auto).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: force the fast-tier backend ('gateway', 'openrouter', or 'local').
# FAST_TIER_PROVIDER=openrouter

# Optional: local OpenAI-compatible server for the fast tier (e.g. Qwen via llama.cpp).
# Used when FAST_TIER_PROVIDER=local. Free + private.
# LOCAL_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_API_KEY=local
# LOCAL_LLM_MODEL=Qwen3.6-35B-A3B

# Optional: classifier strategy. 'auto' (default) = embeddings when AI_GATEWAY_API_KEY
# is set, else regex. 'semantic' = always embeddings. 'regex' = free/offline heuristic.
# CLASSIFIER=auto
# Optional: embedding model for the semantic classifier.
# EMBED_MODEL=openai/text-embedding-3-small

# Optional: credit-warning thresholds in USD.
# CREDIT_WARN_THRESHOLD_USD=5
# CREDIT_CRITICAL_THRESHOLD_USD=1
